]]></script>
        <help><![CDATA[
<h1>Bria Dashboard</h1>

<p>Set up your Bria API key for Houdini.</p>

<h2>Getting Started</h2>
<ol>
    <li>Open the Bria login page.</li>
    <li>Open the API keys page in the console.</li>
    <li>Copy an API key and paste it into the panel.</li>
    <li>Click Save to write it to <code>~/.bria/bria.json</code>.</li>
</ol>

<h2>Notes</h2>
<ul>
    <li>The API key is saved locally in <code>~/.bria/bria.json</code>.</li>
    <li>The key is not stored in scene files.</li>
</ul>
]]></help>
        <includeInPaneTabMenu menu_position="100" create_separator="false">True</includeInPaneTabMenu>
        <includeInToolbarMenu menu_position="100" create_separator="false">True</includeInToolbarMenu>
    </interface>
</pythonPanelDocument>