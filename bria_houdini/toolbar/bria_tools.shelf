<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- This file contains definitions of shelves, toolbars, and tools.
 It should not be hand-edited when it is being used by the application.
 Note, that two definitions of the same element are not allowed in
 a single file. -->

  <toolshelf name="bria_ai" label="Bria AI">
    <memberTool name="bria_dashboard"/>
  </toolshelf>

  <tool name="bria_dashboard" label="Bria Dashboard" icon="PLASMA_App">
    <script scriptType="python"><![CDATA[import hou
import traceback

def open_bria_dashboard_panel():
    """Open the Bria Dashboard Python Panel."""

    interface = hou.pypanel.interfaceByName("bria_dashboard")
    if interface is None:
        raise RuntimeError("Python panel 'bria_dashboard' not found. Check HOUDINI_PYTHON_PANEL_PATH.")

    # Search all pane tabs for an existing Bria Dashboard panel.
    desktop = hou.ui.curDesktop()
    for pane in desktop.panes():
        for tab in pane.tabs():
            if tab.type() == hou.paneTabType.PythonPanel:
                active = tab.activeInterface()
                if active is not None and active.name() == "bria_dashboard":
                    tab.setIsCurrentTab()
                    return True

    # Also check floating panels.
    for panel in desktop.floatingPanels():
        for pane in panel.panes():
            for tab in pane.tabs():
                if tab.type() == hou.paneTabType.PythonPanel:
                    active = tab.activeInterface()
                    if active is not None and active.name() == "bria_dashboard":
                        tab.setIsCurrentTab()
                        return True

    # No existing Bria Dashboard found — create a fresh floating pane.
    pane = desktop.createFloatingPane(hou.paneTabType.PythonPanel)
    python_panel = pane.tabs()[0]
    python_panel.setActiveInterface(interface)
    if hasattr(python_panel, "setIsCurrentTab"):
        python_panel.setIsCurrentTab()

    return True


# Open the Bria Configuration Python Panel
try:
    open_bria_dashboard_panel()
except Exception as e:
    tb = traceback.format_exc()
    hou.ui.displayMessage(
        f"Could not open dashboard panel: {e}\n\n{tb}",
        title="Bria Dashboard",
        severity=hou.severityType.Warning
    )
    ]]></script>
  </tool>
</shelfDocument>
